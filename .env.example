# MLG Autohaus — environment variables
# These are populated automatically in Lovable Cloud. For self-hosting, fill them in.

# === Supabase / Backend (auto-provisioned by Lovable Cloud) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# === Server-only (never exposed to the browser) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === reCAPTCHA v3 (Google test keys are fine for development) ===
# Get production keys from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# === Email notifications ===
# Dev mode logs to the server console. Configure SMTP for production.
ADMIN_NOTIFY_EMAIL=admin@mlgautohaus.com
MAIL_FROM=no-reply@mlgautohaus.com

# === Public site URL (used in sitemap.xml + robots.txt) ===
SITE_URL=https://mlgautohaus.lovable.app
